<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · CampusRooming</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="wrap site-header__row">
      <a href="/" class="brand">
        <span class="brand__mark">CR</span>
        <span class="brand__name">CampusRooming</span>
      </a>
      <nav class="main-nav">
        <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Browse</a>
        <% if (currentUser) { %>
          <a href="/rooms/new" class="<%= currentPath === '/rooms/new' ? 'is-active' : '' %>">List a room</a>
          <a href="/my-rooms" class="<%= currentPath === '/my-rooms' ? 'is-active' : '' %>">My listings</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'is-active' : '' %>">Admin</a>
          <% } %>
        <% } %>
      </nav>
      <div class="auth-area">
        <% if (currentUser) { %>
          <span class="auth-area__name">Hi, <%= currentUser.name.split(' ')[0] %></span>
          <form action="/logout" method="POST">
            <button type="submit" class="btn btn--ghost btn--small">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn--ghost btn--small">Log in</a>
          <a href="/register" class="btn btn--primary btn--small">Sign up</a>
        <% } %>
      </div>
    </div>
  </header>
  <main>
